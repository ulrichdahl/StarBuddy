# StarMaker Discord bot configuration

# Bot token from the Discord developer portal (Bot -> Token).
DISCORD_BOT_TOKEN=

# Application (client) id from the Discord developer portal (General Information).
DISCORD_APPLICATION_ID=

# The Discord server (guild) id slash commands are registered to.
HOME_GUILD_ID=

# Base URL of the Laravel backend's internal bot API.
# In docker compose the internal API is reached through the web container: http://web/
# Default targets the app container directly.
BACKEND_URL=http://app:8000

# Shared bearer token for the Laravel internal bot API.
# Used both when the bot calls the backend and when the backend posts
# notifications to the bot's /notify webhook. Must match the backend config.
BOT_API_TOKEN=

# Port for the notification webhook server (optional, default 3000).
#NOTIFY_PORT=3000
