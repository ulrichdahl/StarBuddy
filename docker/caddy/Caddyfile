# StarBuddy reverse proxy. Plain HTTP on :80 inside the container; put your
# TLS-terminating proxy in front, or change this to your domain name and
# publish 443 to let Caddy manage certificates itself.
# Baked into the web image (docker/web/Dockerfile) — after editing, rebuild:
#   docker compose -f docker-compose.yml up -d --build web
# The TLS-terminating proxy in front (Coolify's Traefik, nginx, …) sits on a
# private Docker network. Trust its X-Forwarded-Proto/-Host/-Port, so Laravel
# sees the request as https: without this, every redirect it builds (the end
# of a Discord sign-in) points at http://YOUR-DOMAIN:443/, which the proxy
# answers with a 404.
{
	servers {
		trusted_proxies static private_ranges
	}
}

:80 {
	encode gzip

	# Backend paths → PHP-FPM in the app container. The root directive must
	# be at handle level: php_fastcgi's file matcher resolves against the
	# site root (a copy of backend/public baked into this image).
	# Upstreams use starbuddy-* aliases: this container also sits on the
	# operator's proxy network, where generic names like "app" can resolve
	# to foreign containers.
	@backend path /api/* /sanctum/* /up /broadcasting/*
	handle @backend {
		root * /var/www/html/public
		php_fastcgi starbuddy-app:9000
	}

	# Reverb websockets.
	handle /app/* {
		reverse_proxy starbuddy-reverb:8081
	}

	# Everything else is the SPA.
	handle {
		root * /srv/frontend
		try_files {path} /index.html
		file_server
	}
}
