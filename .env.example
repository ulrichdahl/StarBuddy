# ── StarMaker instance configuration ─────────────────────────────────────
# Copy to .env and fill in. One instance = one Discord community.

APP_NAME=StarMaker
APP_ENV=production
APP_DEBUG=false
# Generate with: docker compose exec app php artisan key:generate --show
APP_KEY=
# Public URL of this instance (what members type in their browser).
APP_URL=http://localhost:8080
HTTP_PORT=8080

# ── Discord application (https://discord.com/developers/applications) ────
# OAuth2 → add redirect: ${APP_URL}/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=${APP_URL}/api/auth/discord/callback
# Bot → token (also invite the bot to your server with the bot scope).
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=

# ── Community gate ────────────────────────────────────────────────────────
# Your Discord server id. Only its members can sign in.
STARMAKER_HOME_GUILD_ID=
# Shared secret between backend and bot. Generate: openssl rand -hex 32
STARMAKER_BOT_API_TOKEN=
# Optional: map Discord role ids to org names, e.g. {"123456789":"Stellar Forge"}
STARMAKER_ROLE_ORG_MAP={}

# ── Database & cache ──────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=starmaker
DB_USERNAME=starmaker
DB_PASSWORD=

REDIS_CLIENT=predis
REDIS_HOST=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

# Cookie/session scope — set to your domain (no scheme), e.g. starmaker.example.org
SESSION_DOMAIN=localhost
SANCTUM_STATEFUL_DOMAINS=localhost:8080

# ── Reverb (websockets) ───────────────────────────────────────────────────
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=starmaker
REVERB_APP_KEY=starmaker-key
REVERB_APP_SECRET=
REVERB_HOST=web
REVERB_PORT=80
REVERB_SCHEME=http

LOG_CHANNEL=stderr
LOG_LEVEL=info
