# ── StarBuddy instance configuration ─────────────────────────────────────
# Copy to .env and fill in. One instance = one Discord community.
#
# PRODUCTION (behind your own SSL proxy): start with
#   docker compose -f docker-compose.yml up -d
# and set APP_URL, DISCORD_REDIRECT_URI, SESSION_DOMAIN and
# SANCTUM_STATEFUL_DOMAINS to your public https domain. No host ports are
# published; point the proxy at http://starbuddy-web:80 on the "proxy" net.

APP_NAME=StarBuddy
APP_ENV=production
APP_DEBUG=false
# Generate BEFORE first start: echo "base64:$(openssl rand -base64 32)"
APP_KEY=
# Public URL of this instance (what members type in their browser).
# Keep DISCORD_REDIRECT_URI and SANCTUM_STATEFUL_DOMAINS in sync with it.
APP_URL=http://localhost:8080
# Local development only (docker-compose.override.yml publishes this port).
HTTP_PORT=8080

# Where persistent data lands on the host: ${STARBUDDY_DATA_DIR}/postgres
# (database) and ${STARBUDDY_DATA_DIR}/backups (nightly dumps). Use an
# absolute path on servers, e.g. /srv/starbuddy/data — back this dir up.
STARBUDDY_DATA_DIR=./data

# Docker network your reverse proxy lives on; the web container joins it as
# "starbuddy-web". Self-hosted nginx: proxy (default). Coolify: coolify.
STARBUDDY_PROXY_NETWORK=proxy

# ── Discord application (https://discord.com/developers/applications) ────
# OAuth2 → add this exact redirect URL in the portal too.
# (Write it out in full — ${VAR} substitution does NOT work in this file.)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8080/api/auth/discord/callback
# Bot → token (also invite the bot to your server with the bot scope).
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=

# ── Community gate ────────────────────────────────────────────────────────
# Your Discord server id. Only its members can sign in.
STARBUDDY_HOME_GUILD_ID=
# Shared secret between backend and bot. Generate: openssl rand -hex 32
STARBUDDY_BOT_API_TOKEN=
# Optional: map Discord role ids to org names, e.g. {"123456789":"Stellar Forge"}
STARBUDDY_ROLE_ORG_MAP={}

# Optional: Discord channel id that gets a ping when a member's refinery
# work order completes (live events only). Leave empty to disable.
STARBUDDY_REFINERY_CHANNEL_ID=

# RSI service status (status.robertsspaceindustries.com) is checked every
# minute. A new maintenance/outage notice is posted to this channel the
# minute it appears — players get the ~30 min before servers drop to stow
# their gear. Empty = no Discord alerts (website and client still show it).
STARBUDDY_STATUS_CHANNEL_ID=
# Placed above a fresh alert so it pings: @here, @everyone, or a role
# mention like <@&123456789012345678>. Empty = post without pinging.
STARBUDDY_STATUS_MENTION=@here

# ── Database & cache ──────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=starbuddy
DB_USERNAME=starbuddy
DB_PASSWORD=

REDIS_CLIENT=predis
REDIS_HOST=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

# Cookie/session scope — set to your domain (no scheme), e.g. starbuddy.example.org
SESSION_DOMAIN=localhost
SANCTUM_STATEFUL_DOMAINS=localhost:8080

# ── Reverb (websockets) ───────────────────────────────────────────────────
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=starbuddy
REVERB_APP_KEY=starbuddy-key
REVERB_APP_SECRET=
REVERB_HOST=web
REVERB_PORT=80
REVERB_SCHEME=http

LOG_CHANNEL=stderr
LOG_LEVEL=info
